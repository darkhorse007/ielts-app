    "test:e2e:practice-writing-mock": "npx playwright test e2e/practice-writing-mock-flow.spec.mjs",
    "test:e2e:all": "npx playwright test e2e",
    "test:e2e:frontend-full": "npx playwright test e2e/stability-alert-flow.spec.mjs e2e/stability-ui-flow.spec.mjs e2e/system-role-audit-flow.spec.mjs e2e/learner-main-flow.spec.mjs e2e/practice-writing-mock-flow.spec.mjs e2e/stability-page-flow.spec.mjs e2e/observability-storage-alerting-flow.spec.mjs e2e/visual-snapshots.spec.mjs",
    "test:e2e:stability": "npx playwright test e2e/stability-alert-flow.spec.mjs",
    "test:e2e:stability-page": "npx playwright test e2e/stability-page-flow.spec.mjs",
