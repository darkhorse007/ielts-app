# Required in runtime: provide exactly one of AUTH_SECRET or AUTH_SECRET_FILE.
AUTH_SECRET=replace-with-a-32-char-or-longer-secret
# AUTH_SECRET_FILE=/run/secrets/ielts-app-auth-secret

# Keep RBAC enabled in non-test environments unless a drill explicitly disables it.
SYSTEM_RBAC_ENFORCED=true

# Payment provider runtime freeze.
PAYMENT_PROVIDER_DEFAULT=alipay
PAYMENT_WEBHOOK_TIMESTAMP_TOLERANCE_SECONDS=300
PAYMENT_MOCKPAY_ENABLED=false
PAYMENT_STRIPE_ENABLED=true
PAYMENT_STRIPE_WEBHOOK_SECRET=replace-with-live-stripe-webhook-secret
# PAYMENT_STRIPE_WEBHOOK_SECRET_FILE=/run/secrets/ielts-app-payment-stripe-webhook
PAYMENT_ALIPAY_ENABLED=true
PAYMENT_ALIPAY_WEBHOOK_SECRET=replace-with-live-alipay-webhook-secret
# PAYMENT_ALIPAY_WEBHOOK_SECRET_FILE=/run/secrets/ielts-app-payment-alipay-webhook

# AI provider runtime freeze.
LLM_PRIMARY_PROVIDER_NAME=openai
LLM_PRIMARY_ENDPOINT=https://api.openai.example/v1
LLM_PRIMARY_API_KEY=replace-with-live-openai-key
# LLM_PRIMARY_API_KEY_FILE=/run/secrets/ielts-app-llm-primary-key
LLM_PRIMARY_DATA_REGION=us
LLM_FALLBACK_ENABLED=false
# LLM_FALLBACK_PROVIDER_NAME=anthropic
# LLM_FALLBACK_ENDPOINT=https://api.anthropic.example/v1
# LLM_FALLBACK_API_KEY=replace-with-live-fallback-llm-key
# LLM_FALLBACK_API_KEY_FILE=/run/secrets/ielts-app-llm-fallback-key
# LLM_FALLBACK_DATA_REGION=us
# LLM_ALLOW_USER_CONTENT_LOGGING=false
