{
  "expo": {
    "name": "IELTS Mobile",
    "slug": "ielts-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "ielts-mobile",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "plugins": [
      "expo-dev-client",
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#08111F",
          "defaultChannel": "study-reminders"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Allow $(PRODUCT_NAME) to access your microphone for speaking practice and pronunciation feedback."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow $(PRODUCT_NAME) to use the microphone for live speaking answers.",
          "speechRecognitionPermission": "Allow $(PRODUCT_NAME) to convert your live speaking answers into transcripts."
        }
      ]
    ],
    "ios": {
      "bundleIdentifier": "com.darkhorse.ieltsmobile",
      "buildNumber": "1",
      "supportsTablet": false
    },
    "android": {
      "package": "com.darkhorse.ieltsmobile",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "experiments": {
      "typedRoutes": false
    }
  }
}
